<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>duel-server</AssemblyName>
    <RootNamespace>DuelServer</RootNamespace>

    <!-- A ocgcore.dll e a sqlite3.dll sao Windows x64.
         O processo PRECISA ser 64-bit, senao o DllImport falha com BadImageFormat. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Distribuicao: `npm run pack` gera duel-server/payload.zip (web, dados,
       cards.cdb e os scripts lua) e ele entra COMO RECURSO no executavel, para o
       jogo poder ser entregue como um arquivo unico. No dia a dia o zip nao
       existe, a condicao nao bate e o build sai igual ao de sempre. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <!-- Token de distribuicao (PAT fine-grained, Contents: Read-only) do repositorio
       privado de Releases. Mesma condicional do payload: se o token.txt existe ele
       entra como recurso; se nao existe - o dia a dia - o build sai igual ao de
       sempre e o updater roda sem autenticacao. O arquivo NAO vai para o git. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\token.txt')">
    <EmbeddedResource Include="token.txt" LogicalName="token.txt" />
  </ItemGroup>

  <!-- Copia as bibliotecas nativas para junto do executavel, para o
       DllImport("ocgcore") / DllImport("sqlite3") encontra-las. -->
  <ItemGroup>
    <None Include="native\ocgcore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ocgcore.dll</Link>
    </None>
    <None Include="native\sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sqlite3.dll</Link>
    </None>
  </ItemGroup>

</Project>
