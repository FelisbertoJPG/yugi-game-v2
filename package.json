{
  "name": "yugi-game-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mini RPG de Yu-Gi-Oh com duelo fiel as regras oficiais, front web em estilo retro.",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "data:build": "python ygo-data/tools/build.py",
    "data:check": "node ygo-data/examples/node-demo.mjs",
    "launcher:build": "dotnet publish launcher -c Release -o . -v q --nologo && dotnet publish launcher/stop -c Release -o . -v q --nologo",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-release.ps1",
    "release:test": ".\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-release dist/release",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/publish-release.ps1 -Publish",
    "update:test": ".\\duel-academy-stop.exe && dotnet build duel-server -v q --nologo && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-update && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-offline && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-selfupdate && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-update-duelo",
    "stop": ".\\duel-academy-stop.exe",
    "duel:build": ".\\duel-academy-stop.exe && dotnet build duel-server -v q --nologo",
    "duel:test": ".\\duel-academy-stop.exe && dotnet build duel-server -v q --nologo && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-npc && .\\duel-server\\bin\\Debug\\net8.0\\win-x64\\duel-server.exe --test-summons"
  },
  "engines": {
    "node": ">=18"
  }
}
