<Project Sdk="Microsoft.NET.Sdk">

  <!-- A CASCA. Ate' 19/08/2026 este projeto era o jogo inteiro; hoje ele compila
       so' `host/` e o motor mora em `engine/duel-engine.csproj`
       (DuelServer.Engine.dll), carregado do disco em tempo de execucao. E' o que
       permite entregar uma mudanca de C# como um pacote de ~400 KB em vez de um
       executavel de 67,8 MB. Ver host/Program.cs. -->

  <PropertyGroup>
    <!-- WinExe, e nao Exe: o Windows para de criar a janela de terminal. Ela
         aparecia por cima do jogo e tinha de ser minimizada, o que para quem nao
         e' tecnico e' ruido — e era ELA o botao de fechar ("DEIXE ESTA JANELA
         ABERTA"). Quem diz agora que o jogo esta' na tela e' a batida das
         paginas (`web/js/vivo.js` + `WebServer.VigiarAJanela`).

         O preco esta' pago em `host/Console.cs`: um WinExe chamado de um
         terminal nao se anexa a ele, e as suites de linha de comando ficariam
         mudas. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- O nome NAO muda: `npm run duel:build`, as suites de teste, o launcher e o pack todos chamam duel-server.exe. -->
    <AssemblyName>duel-server</AssemblyName>
    <RootNamespace>ClassicDuels.Casca</RootNamespace>

    <!-- O processo PRECISA ser 64-bit: as bibliotecas nativas sao x64 e o
         DllImport falharia com BadImageFormat num processo 32-bit. -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- win-x64 continua sendo o PADRAO: e' o jogo de mesa, o `npm run pack` e
         todos os scripts do package.json, que esperam a saida em
         bin/<conf>/net8.0/win-x64/. Passar `-r linux-x64` sobrescreve, e e'
         assim que o servidor de duelo online (arena) e' compilado — mesmo
         codigo, outra plataforma. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!-- Os fontes da casca sao so' os de host/. O glob padrao puxaria tambem os
         fontes do motor (src/) e os que o SDK gera dentro de engine/obj — o
         mesmo motivo do `Compile Remove` que o launcher usa para stop/. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- O icone do jogo. Gerado em codigo por tools/gerar-icone.mjs — o desenho
         e o codigo sao a mesma coisa, nao existe binario sem fonte. -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)../assets/icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="host\**\*.cs" />
    <None Remove="engine\**" />
    <None Remove="src\**" />
  </ItemGroup>

  <!-- O motor. `ReferenceOutputAssembly` fica LIGADO de proposito: e' o que poe o
       DuelServer.Engine.dll ao lado do .exe (e dentro do bundle, no pack), que e'
       a copia de reserva usada quando nao ha' motor no disco — e a unica que
       existe em desenvolvimento. A casca nunca usa um TIPO do motor: ela chama
       tudo por reflexao, senao o runtime carregaria esta copia antes de a gente
       ter a chance de preferir a do disco. -->
  <ItemGroup>
    <ProjectReference Include="engine\duel-engine.csproj" />
  </ItemGroup>

  <!-- Distribuicao: `npm run pack` gera duel-server/payload.zip (web, dados,
       cards.cdb, os scripts lua e os pacotes do motor) e ele entra COMO RECURSO
       no executavel, para o jogo poder ser entregue como um arquivo unico. No dia
       a dia o zip nao existe, a condicao nao bate e o build sai igual ao de
       sempre. Fica na CASCA, e nao no motor: ela e' quem precisa dele antes de o
       motor existir no disco. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\payload.zip')">
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

  <!-- Token de distribuicao (PAT fine-grained, Contents: Read-only) do repositorio
       privado de Releases. Mesma condicional do payload: se o token.txt existe ele
       entra como recurso; se nao existe - o dia a dia - o build sai igual ao de
       sempre e o updater roda sem autenticacao. O arquivo NAO vai para o git.

       Fica na casca de proposito: o `engine.zip` publicado e' baixado por QUEM
       ja' tem o token, entao um token dentro do motor seria distribuido no
       pacote sem ganhar nada — e nao daria para rodar sem ele de qualquer jeito. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\token.txt')">
    <EmbeddedResource Include="token.txt" LogicalName="token.txt" />
  </ItemGroup>

  <!-- Bibliotecas nativas do WINDOWS, copiadas para junto do executavel para o
       DllImport("ocgcore") / DllImport("sqlite3") encontra-las.

       Aqui elas servem ao DESENVOLVIMENTO e ao primeiro boot; na instalacao do
       jogador quem manda sao as de `engine/` (pacote `native`), resolvidas pelo
       `Motor.LigarResolvedorDeNativas`.

       Condicionado ao RID: num build linux-x64 estes .dll nao servem para nada
       e, pior, seriam copiados para a imagem do servidor sem que ninguem
       percebesse. No Linux o par e' `libocgcore.so` (compilado da fonte do
       ygopro-core) e a `libsqlite3` do sistema — ver o Dockerfile da arena. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <None Include="native\ocgcore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ocgcore.dll</Link>
    </None>
    <None Include="native\sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>sqlite3.dll</Link>
    </None>
  </ItemGroup>

  <!-- No Linux, `libocgcore.so` e' gerado no build da imagem e entra por aqui
       quando existir (assim o build local sem o .so nao quebra). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And Exists('$(MSBuildProjectDirectory)/native/libocgcore.so')">
    <None Include="native/libocgcore.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libocgcore.so</Link>
    </None>
  </ItemGroup>

</Project>
